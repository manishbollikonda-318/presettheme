# ── Database (Supabase) ──
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=10

# ── JWT (RS256) ──
# Base64-encoded PEM keys — generate with: npm run generate-keys
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=7d
JWT_GUEST_TTL=4h

# ── QR Encryption (AES-256-GCM) ──
# 32-byte hex key — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_ENCRYPTION_KEY=
QR_TOKEN_TTL_HOURS=24

# ── Server ──
PORT=4321
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:4321

# ── Rate Limits (per minute) ──
RATE_LIMIT_LOGIN=5
RATE_LIMIT_QR_VERIFY=20
RATE_LIMIT_ORDER_CREATE=10
